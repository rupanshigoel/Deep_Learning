#!/bin/sh
# Stage-2 FULL-DATA evaluation (10K stratified train + 10K stratified val).
# Submit this AFTER vlm_s2_full_c5 completes (i.e. checkpoints/full/vlm_stage2_full_*).
# Time estimate: 20K samples * 0.19s/sample (batch=8 effective) = ~1.05 h GPU-time.
# 10K val is what we'd quote as the "headline" stage-2 number; it covers each of the
# 28 answer classes ~360 times (cap at 1.5x uniform), so the per-category numbers
# tighten (CIs shrink from ~5% at n=2500 to ~2.5% at n=10000).
#PBS -N vlm_eval_s2_full
#PBS -P col775.mt1230785.course
#PBS -q standard
#PBS -m bea
#PBS -M mt1230785@iitd.ac.in
#PBS -l select=1:ncpus=8:ngpus=1:centos=icelake
#PBS -l walltime=03:00:00
#PBS -o logs/vlm_eval_s2_full.out
#PBS -e logs/vlm_eval_s2_full.err

echo "================================"
echo "PBS jobid : $PBS_JOBID"
date
echo "================================"

cd $PBS_O_WORKDIR
mkdir -p logs

module load compiler/cuda/12.3/compilervars 2>/dev/null || true
source $HOME/condaBaseSetup
conda activate col775_t25

export HF_HOME="$PBS_O_WORKDIR/archive/hf_cache"
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1

nvidia-smi 2>/dev/null || true

python -u -m col775_a2.eval_vlm \
    --stage 2 \
    --projector-ckpt    "$PBS_O_WORKDIR/checkpoints/full/vlm_stage2_full_final.pt" \
    --lora-dir          "$PBS_O_WORKDIR/checkpoints/full/vlm_stage2_full_lora_final" \
    --dino-ckpt         "$PBS_O_WORKDIR/checkpoints/dino_final.pt" \
    --qwen-path         "Qwen/Qwen3-4B-Instruct-2507" \
    --clevrx-train-json "$PBS_O_WORKDIR/A2_dataset/Part_B/CLEVR_X/CLEVR_train_explanations_v0.7.10.json" \
    --recut-pkl         "$PBS_O_WORKDIR/A2_dataset/Part_B/CLEVR_X/train_images_ids_v0.7.10-recut.pkl" \
    --train-images-dir  "$PBS_O_WORKDIR/A2_dataset/Part_Aa/Clevr_official/images/train" \
    --clevrx-val-json   "$PBS_O_WORKDIR/A2_dataset/Part_B/CLEVR_X/CLEVR_val_explanations_v0.7.10.json" \
    --val-images-dir    "$PBS_O_WORKDIR/A2_dataset/Part_Aa/Clevr_official/images/val" \
    --out-dir           "$PBS_O_WORKDIR/logs/vlm_eval_stage2_full" \
    --batch-size 8 --num-workers 4 \
    --train-subsample 10000 --val-subsample 10000 \
    --max-new-tokens 192

echo "================================"
echo "exit code : $?"
date
echo "================================"
