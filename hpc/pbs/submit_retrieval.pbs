#!/bin/sh
# Retrieval-only re-run (the probe job's retrieval step crashed on cuDNN 9 SDPA
# while extract / linear_probe / tsne all succeeded). Quick + cheap.
#PBS -N retrieval_clevr
#PBS -P col775.mt1230785.course
#PBS -q high
#PBS -m bea
#PBS -M mt1230785@iitd.ac.in
#PBS -l select=1:ncpus=8:ngpus=1:centos=icelake
#PBS -l walltime=00:30:00
#PBS -o logs/retrieval.out
#PBS -e logs/retrieval.err

echo "================================"
echo "PBS jobid : $PBS_JOBID"
echo "node list : $(cat $PBS_NODEFILE)"
date
echo "================================"

cd $PBS_O_WORKDIR
mkdir -p logs plots

module load compiler/cuda/12.3/compilervars 2>/dev/null || true

source $HOME/condaBaseSetup
conda activate col775_t25

nvidia-smi 2>/dev/null || true
python -c "import torch; print('torch', torch.__version__, 'cuda?', torch.cuda.is_available())"

python -u -m col775_a2.retrieval \
    --clip-ckpt "$PBS_O_WORKDIR/checkpoints/clip_last.pt" \
    --out-dir   "$PBS_O_WORKDIR/plots" \
    --num-workers 6

echo "================================"
echo "exit code : $?"
date
echo "================================"
