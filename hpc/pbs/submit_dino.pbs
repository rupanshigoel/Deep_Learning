#!/bin/sh
#PBS -N dino_clevr
#PBS -P col775.mt1230785.course
#PBS -q high
#PBS -m bea
#PBS -M mt1230785@iitd.ac.in
#PBS -l select=1:ncpus=16:ngpus=1:centos=icelake
#PBS -l walltime=04:00:00
#PBS -o logs/dino.out
#PBS -e logs/dino.err

echo "================================"
echo "PBS jobid : $PBS_JOBID"
echo "node list : $(cat $PBS_NODEFILE)"
echo "workdir   : $PBS_O_WORKDIR"
date
echo "================================"

cd $PBS_O_WORKDIR
mkdir -p logs checkpoints

module load compiler/cuda/12.3/compilervars 2>/dev/null || true

source $HOME/condaBaseSetup
conda activate col775_t25

nvidia-smi 2>/dev/null || true
python -c "import torch; print('torch', torch.__version__, 'cuda?', torch.cuda.is_available())"

# The trainer writes checkpoints/dino_last.pt after every epoch and auto-resumes.
# If this job is killed by the 24h walltime, just re-submit — it picks up where it left off.
python -u -m col775_a2.train_dino \
    --data-root  "$PBS_O_WORKDIR/A2_dataset/Part_A" \
    --ckpt-dir   "$PBS_O_WORKDIR/checkpoints" \
    --log-dir    "$PBS_O_WORKDIR/logs" \
    --num-workers 12 \
    --batch-size 128 \
    --epochs 100

echo "================================"
echo "exit code : $?"
date
echo "================================"
