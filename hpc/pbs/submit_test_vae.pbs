#!/bin/sh
# 2-epoch smoke test for the VAE. ~5-10 min on A100. Cost ~Rs 1.
#PBS -N vae_test
#PBS -P col775.mt1230785.course
#PBS -q standard
#PBS -m bea
#PBS -M mt1230785@iitd.ac.in
#PBS -l select=1:ncpus=8:ngpus=1:centos=icelake
#PBS -l walltime=01:00:00
#PBS -o logs/vae_test.out
#PBS -e logs/vae_test.err

echo "================================"
echo "PBS jobid : $PBS_JOBID"
echo "node list : $(cat $PBS_NODEFILE)"
echo "workdir   : $PBS_O_WORKDIR"
date
echo "================================"

cd $PBS_O_WORKDIR
mkdir -p logs logs_test_vae checkpoints_test_vae

module load compiler/cuda/12.3/compilervars 2>/dev/null || true
source $HOME/condaBaseSetup
conda activate col775_t25

nvidia-smi 2>/dev/null || true
python -c "import torch; print('torch', torch.__version__, 'cuda?', torch.cuda.is_available())"

python -u -m col775_a2.train_vae \
    --data-root "$PBS_O_WORKDIR/A2_dataset/Part_A" \
    --ckpt-dir  "$PBS_O_WORKDIR/checkpoints_test_vae" \
    --log-dir   "$PBS_O_WORKDIR/logs_test_vae" \
    --num-workers 8 \
    --batch-size 64 \
    --epochs 2 \
    --log-every 20

echo "================================"
echo "exit code : $?"
date
echo "================================"
