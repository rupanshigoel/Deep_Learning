#!/bin/sh
# Stage-2 evaluation on FULL-data checkpoint, run on FRIEND's account (mt1230762).
# 10K stratified val + 10K stratified train. Greedy decoding, batch=8, max-new-tokens=192.
# Reports EM (per assignment §3.2) on both splits + qualitative correct/incorrect grids.
# Throughput ~0.65 samp/s × 20 000 = ~8.5 h GPU; walltime 10 h gives comfortable leeway.
#
# Chained afterok:898843 (the top-up training job).
#PBS -N vlm_eval_s2_friend
#PBS -P col775.mt1230762.course
#PBS -q high
#PBS -m bea
#PBS -M mt1230762@iitd.ac.in
#PBS -l select=1:ncpus=8:ngpus=1:centos=icelake
#PBS -l walltime=10:00:00
#PBS -o logs/vlm_eval_s2_friend.out
#PBS -e logs/vlm_eval_s2_friend.err

echo "================================"
echo "PBS jobid : $PBS_JOBID  (Stage-2 eval, 10K+10K stratified)"
date
echo "================================"

cd $PBS_O_WORKDIR
mkdir -p logs/vlm_eval_stage2_full

module load compiler/cuda/12.3/compilervars 2>/dev/null || true
source $HOME/condaBaseSetup
# Use assignment-mandated env (Python 3.10, torch 2.5.0+cu118), shared from user via ACL.
conda activate /home/maths/btech/mt1230785/.conda/envs/col775_t25
export PYTHONDONTWRITEBYTECODE=1

export HF_HOME="$PBS_O_WORKDIR/archive/hf_cache"
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1

nvidia-smi 2>/dev/null || true
python -c "import torch, peft, transformers; print('torch', torch.__version__, 'peft', peft.__version__, 'transformers', transformers.__version__)"

python -u -m col775_a2.eval_vlm \
    --stage 2 \
    --projector-ckpt    "$PBS_O_WORKDIR/checkpoints/full/vlm_stage2_full_final.pt" \
    --lora-dir          "$PBS_O_WORKDIR/checkpoints/full/vlm_stage2_full_lora_final" \
    --dino-ckpt         "$PBS_O_WORKDIR/checkpoints/dino_final.pt" \
    --qwen-path         "Qwen/Qwen3-4B-Instruct-2507" \
    --clevrx-train-json "$PBS_O_WORKDIR/A2_dataset/Part_B/CLEVR_X/CLEVR_train_explanations_v0.7.10.json" \
    --recut-pkl         "$PBS_O_WORKDIR/A2_dataset/Part_B/CLEVR_X/train_images_ids_v0.7.10-recut.pkl" \
    --train-images-dir  "$PBS_O_WORKDIR/A2_dataset/Part_Aa/Clevr_official/images/train" \
    --clevrx-val-json   "$PBS_O_WORKDIR/A2_dataset/Part_B/CLEVR_X/CLEVR_val_explanations_v0.7.10.json" \
    --val-images-dir    "$PBS_O_WORKDIR/A2_dataset/Part_Aa/Clevr_official/images/val" \
    --out-dir           "$PBS_O_WORKDIR/logs/vlm_eval_stage2_full" \
    --batch-size 8 --num-workers 4 \
    --train-subsample 10000 --val-subsample 10000 \
    --max-new-tokens 192 \
    --n-qualitative 5
RC=$?

echo "================================"
echo "exit code : $RC"
date
echo "================================"
exit $RC
