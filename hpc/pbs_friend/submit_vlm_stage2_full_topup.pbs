#!/bin/sh
# Stage-2 top-up: finish 1 true epoch over filtered (559969-entry) CLEVR-X.
# Resume from friend's _last (step 16160), iterate with fresh shuffle (slice_seed=43),
# stop at step 17499 = floor(559969/32). ~1339 optim-steps, ~2.5h actual.
#PBS -N vlm_s2_topup
#PBS -P col775.mt1230762.course
#PBS -q high
#PBS -m bea
#PBS -M mt1230762@iitd.ac.in
#PBS -l select=1:ncpus=16:ngpus=1:centos=icelake
#PBS -l walltime=04:00:00
#PBS -o logs/vlm_s2_topup.out
#PBS -e logs/vlm_s2_topup.err

echo "================================"
echo "PBS jobid : $PBS_JOBID  (top-up to step 17499 = full true epoch)"
date
echo "================================"

cd $PBS_O_WORKDIR
mkdir -p logs/full checkpoints/full

module load compiler/cuda/12.3/compilervars 2>/dev/null || true
source $HOME/condaBaseSetup
conda activate /home/maths/btech/mt1230785/.conda/envs/col775_t25
export PYTHONDONTWRITEBYTECODE=1

export HF_HOME="$PBS_O_WORKDIR/archive/hf_cache"
export TRANSFORMERS_OFFLINE=1
export HF_HUB_OFFLINE=1

nvidia-smi 2>/dev/null || true

python -u -m col775_a2.train_vlm_stage2 \
    --clevrx-json  "$PBS_O_WORKDIR/A2_dataset/Part_B/CLEVR_X/CLEVR_train_explanations_v0.7.10.json" \
    --recut-pkl    "$PBS_O_WORKDIR/A2_dataset/Part_B/CLEVR_X/train_images_ids_v0.7.10-recut.pkl" \
    --images-dir   "$PBS_O_WORKDIR/A2_dataset/Part_Aa/Clevr_official/images/train" \
    --dino-ckpt    "$PBS_O_WORKDIR/checkpoints/dino_final.pt" \
    --stage1-ckpt  "$PBS_O_WORKDIR/checkpoints/vlm_stage1_projector.pt" \
    --qwen-path    "Qwen/Qwen3-4B-Instruct-2507" \
    --ckpt-dir     "$PBS_O_WORKDIR/checkpoints/full" \
    --log-dir      "$PBS_O_WORKDIR/logs/full" \
    --slice-start 0 --slice-end 559969 --slice-seed 43 \
    --total-train-steps 21875 \
    --max-steps 17499 \
    --batch-size 2 --grad-accum 16 --lr 2e-4 --epochs 1 \
    --num-workers 12 --log-every 20 --ckpt-every-steps 200
RC=$?

if [ "$RC" = "0" ]; then
    cp -r "$PBS_O_WORKDIR/checkpoints/full/vlm_stage2_lora_last" "$PBS_O_WORKDIR/checkpoints/full/vlm_stage2_full_lora_final" 2>/dev/null || true
    cp    "$PBS_O_WORKDIR/checkpoints/full/vlm_stage2_last.pt"    "$PBS_O_WORKDIR/checkpoints/full/vlm_stage2_full_final.pt" 2>/dev/null || true
fi

echo "================================"
echo "exit code : $RC"
date
echo "================================"
exit $RC
